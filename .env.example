APP_NAME="Crab Shop"
APP_DEBUG=true

LOG_PATH=storage/logs/app.log
LOG_LEVEL=debug

# DB_DSN=mysql:host=127.0.0.1;dbname=shop
# DB_USERNAME=root
# DB_PASSWORD=

SERVER_ADDRESS=tcp://127.0.0.1:8080
SERVER_WORKERS=2
SERVER_QUEUE=true
SERVER_SCHEDULE=true
SERVER_DISPATCH=false
# Each customer's ShoppingAssistant runs here when the broadcast carrier is redis; off with the local carrier.
SERVER_ACTORS=true

CACHE_STORE=file
BROADCAST_CARRIER=redis
QUEUE_STORE=database
# REDIS_URL=redis://127.0.0.1:6379

CLOCKWERK_TOKEN=sample
