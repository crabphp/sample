APP_NAME="Crab Shop"
APP_URL=http://127.0.0.1:8080
APP_DEBUG=true

LOG_PATH=storage/logs/app.log
LOG_LEVEL=debug

# DB_DSN=mysql:host=127.0.0.1;dbname=shop
# DB_USERNAME=root
# DB_PASSWORD=

SERVER_ADDRESS=tcp://127.0.0.1:8080
SERVER_WORKERS=2

CACHE_STORE=file
BROADCAST_CARRIER=redis
QUEUE_STORE=database
# REDIS_URL=redis://127.0.0.1:6379

CLOCKWERK_TOKEN=sample

# Reports use storage/reports by default. For an existing S3 bucket:
# REPORTS_DRIVER=s3
# S3_KEY=
# S3_SECRET=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000
