APP_NAME="Crab Shop"
APP_DEBUG=true

LOG_PATH=storage/logs/app.log
LOG_LEVEL=debug

# SQLite by default, so the sample runs with nothing installed.
# DB_DSN=mysql:host=127.0.0.1;dbname=shop
# DB_USERNAME=root
# DB_PASSWORD=

SERVER_ADDRESS=tcp://127.0.0.1:8080
SERVER_WORKERS=2
# The sample is for seeing everything work, so `php cua serve` runs the queue's workers and the scheduler
# too. Set either to false to start `queue:work` or `schedule:work` yourself.
SERVER_QUEUE=true
SERVER_SCHEDULE=true

# "file" and "database" need nothing more. Set either to "redis" to try the Redis package.
CACHE_STORE=file
QUEUE_STORE=database
REDIS_URL=redis://127.0.0.1:6379

# Opens the dashboard at /clockwerk?token=sample
CLOCKWERK_TOKEN=sample

# How often the pretend mail server refuses a message, from 0 to 1, to see jobs retried and failed.
MAIL_FAIL_RATE=0.15
