APP_NAME="Crab Shop"
# APP_URL defaults to SERVER_ADDRESS. Set it to the public URL behind a proxy.
# APP_URL=https://shop.example.com
# Leave MODEL_URL unset for the built-in pretend model. For a real OpenAI-compatible model:
# MODEL_URL=https://model.example.com/cpa/v1
# MODEL_API_KEY=your-model-api-key
# MODEL_NAME=gpt-6-astra
# MODEL_ENDPOINT=responses
APP_DEBUG=true
# php cua key:generate writes this; it signs the session cookie.
APP_KEY=

LOG_PATH=storage/logs/app.log
LOG_LEVEL=debug

# DB_DSN=mysql:host=127.0.0.1;dbname=shop
# DB_USERNAME=root
# DB_PASSWORD=

SERVER_ADDRESS=tcp://127.0.0.1:8080
SERVER_WORKERS=2

CACHE_STORE=file
BROADCAST_CARRIER=redis
QUEUE_STORE=database
# REDIS_URL=redis://127.0.0.1:6379

CLOCKWERK_TOKEN=sample

# Reports use storage/reports by default. For an existing S3 bucket:
# REPORTS_DRIVER=s3
# S3_KEY=
# S3_SECRET=
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000
