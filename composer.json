{
    "name": "crabphp/sample",
    "description": "A sample shop API on the Crab framework, with data, for trying what is being built",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "crabphp/framework": "@dev",
        "crabphp/redis": "@dev",
        "crabphp/clockwerk": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "repositories": [
        {"type": "path", "url": "../framework", "options": {"symlink": true}},
        {"type": "path", "url": "../redis", "options": {"symlink": true}},
        {"type": "path", "url": "../clockwerk", "options": {"symlink": true}}
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
