{
    "name": "crabphp/sample",
    "description": "A sample shop API on the Crab framework, with data, for trying what is being built",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "crabphp/arc": "0.3.0",
        "crabphp/framework": "0.7.2",
        "crabphp/runs": "@dev",
        "crabphp/actors": "@dev",
        "crabphp/redis": "@dev",
        "crabphp/clockwerk": "@dev",
        "crabphp/openapi": "@dev",
        "crabphp/s3": "@dev",
        "crabphp/tide": "0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.4",
        "carthage-software/mago": "1.57.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "openapi": "@php cua openapi:generate --strict",
        "openapi:check": "@php cua openapi:generate --strict --check",
        "format": "@php vendor/bin/mago fmt",
        "format:check": "@php vendor/bin/mago fmt --check",
        "lint": "@php vendor/bin/mago lint"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../framework",
            "options": {
                "symlink": true,
                "versions": {
                    "crabphp/framework": "0.7.2"
                }
            }
        },
        {
            "type": "path",
            "url": "../arc",
            "options": {
                "symlink": true,
                "versions": {
                    "crabphp/arc": "0.3.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../runs",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../actors",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../redis",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../clockwerk",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../openapi",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../s3",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../tide",
            "options": {
                "symlink": true,
                "versions": {
                    "crabphp/tide": "0.2.0"
                }
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
